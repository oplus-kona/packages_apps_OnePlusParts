<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.device"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:label="@string/device_settings_title"
        android:persistent="true"
        android:directBootAware="true"
        android:defaultToDeviceProtectedStorage="true"
        android:theme="@style/Theme.SubSettingsBase.Expressive">

        <receiver
            android:name=".BootCompletedReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- DC Dimming Activity -->
        <activity
            android:name=".display.DcDimmingActivity"
            android:label="@string/dc_dimming_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/dc_dimming_summary" />
        </activity>

        <!-- DC Dimming Quick Settings Tile -->
        <service
            android:name=".display.DcDimmingTileService"
            android:exported="true"
            android:icon="@drawable/ic_dc_dimming"
            android:label="@string/dc_dimming_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- High Brightness Mode Activity -->
        <activity
            android:name=".display.HbmActivity"
            android:label="@string/hbm_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/hbm_summary" />
        </activity>

        <!-- High Brightness Mode Quick Settings Tile -->
        <service
            android:name=".display.HbmTileService"
            android:exported="true"
            android:icon="@drawable/ic_hbm"
            android:label="@string/hbm_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Bypass Charging Activity -->
        <activity
            android:name=".power.BypassChargingActivity"
            android:label="@string/bypass_charging_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/bypass_charging_summary" />
        </activity>

        <!-- Bypass Charging Quick Settings Tile -->
        <service
            android:name=".power.BypassChargingTileService"
            android:exported="true"
            android:icon="@drawable/ic_bypass_charging"
            android:label="@string/bypass_charging_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Gentle Charging Activity -->
        <activity
            android:name=".power.GentleChargingActivity"
            android:label="@string/gentle_charging_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.battery" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/gentle_charging_summary" />
        </activity>

        <!-- Gentle Charging Quick Settings Tile -->
        <service
            android:name=".power.GentleChargingTileService"
            android:exported="true"
            android:icon="@drawable/ic_gentle_charging"
            android:label="@string/gentle_charging_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Touch Settings Activity -->
        <activity
            android:name=".touch.TouchSettingsActivity"
            android:label="@string/touch_settings_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/touch_settings_summary" />
        </activity>

        <!-- Game Touch Quick Settings Tile -->
        <service
            android:name=".touch.GameTouchTileService"
            android:exported="true"
            android:icon="@drawable/ic_game_touch"
            android:label="@string/game_touch_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Glove Mode Quick Settings Tile -->
        <service
            android:name=".touch.GloveModeTileService"
            android:exported="true"
            android:icon="@drawable/ic_glove_mode"
            android:label="@string/glove_mode_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Vibration Strength Activity -->
        <activity
            android:name=".vibration.VibratorStrengthActivity"
            android:label="@string/vibrator_strength_title"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/vibrator_strength_summary" />
        </activity>

        <!-- Vibration Strength Quick Settings Tile -->
        <service
            android:name=".vibration.VibratorStrengthTileService"
            android:exported="true"
            android:icon="@drawable/ic_vibration"
            android:label="@string/vibrator_strength_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>


